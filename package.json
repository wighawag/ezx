{
	"name": "ezx",
	"version": "0.0.18",
	"description": "Enhanced zx - Write better shell scripts with markdown preprocessing features including directory context persistence, file extraction, and fixes for zx's indentation parsing issues",
	"keywords": [
		"zx",
		"shell",
		"bash",
		"script",
		"markdown",
		"cli",
		"terminal",
		"automation",
		"preprocessor",
		"code-extraction"
	],
	"author": "Ronan Sandford",
	"license": "MIT",
	"homepage": "https://github.com/wighawag/ezx#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wighawag/ezx.git"
	},
	"bugs": {
		"url": "https://github.com/wighawag/ezx/issues"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"bin": {
		"ezx": "dist/cli.js"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE"
	],
	"dependencies": {
		"commander": "^14.0.2",
		"marked": "^17.0.1",
		"zx": "^8.8.5"
	},
	"devDependencies": {
		"@types/node": "^25.0.10",
		"as-soon": "^0.1.5",
		"typescript": "^5.9.3"
	},
	"scripts": {
		"build": "tsc --project tsconfig.json",
		"dev": "as-soon -w src pnpm build"
	}
}
